---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import WhatYouGetSection from '../components/WhatYouGetSection.astro';
import TestimonialsSection from '../components/TestimonialsSection.astro';
import StudyAreaSection from '../components/StudyAreaSection.astro';
import CertificateSection from '../components/CertificateSection.astro';
import FAQSection from '../components/islands/FAQSection';
import PricingSection from '../components/islands/PricingSection';
---

<Layout title="PedagoMais - Plataforma de Simulados de Pedagogia">
  <Hero />
  
  <!-- Benefits Section -->
  <section class="section-padding bg-neutral-beige">
    <div class="container-custom">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-neutral-dark mb-4">
          Por que escolher o PedagoMais?
        </h2>
        <p class="text-lg text-gray-600 max-w-2xl mx-auto">
          A plataforma mais completa para sua aprovação em concursos de Pedagogia
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        <!-- Benefit 1 -->
        <div class="bg-white p-6 rounded-xl shadow-lg hover:shadow-xl transition-shadow text-center">
          <div class="w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center mb-4 mx-auto">
            <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold mb-2">Aplicativo Instalável</h3>
          <p class="text-gray-700 p-3 rounded-lg" style="background-color: #F3EEFE;">
            Estude onde e quando quiser! Acesse pelo celular, tablet ou computador. Baixe nosso app e tenha todo o conteúdo disponível offline, perfeito para estudar no ônibus, metrô ou em qualquer lugar.
          </p>
        </div>

        <!-- Benefit 2 -->
        <div class="bg-white p-6 rounded-xl shadow-lg hover:shadow-xl transition-shadow text-center">
          <div class="w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center mb-4 mx-auto">
            <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold mb-2">+ 800 questões Comentadas</h3>
          <p class="text-gray-700 p-3 rounded-lg" style="background-color: #F3EEFE;">
            Mais de 800 questões cuidadosamente selecionadas com respostas explicadas. Entenda o porquê de cada alternativa estar certa ou errada e aprenda de verdade.
          </p>
        </div>

        <!-- Benefit 3 -->
        <div class="bg-white p-6 rounded-xl shadow-lg hover:shadow-xl transition-shadow text-center">
          <div class="w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center mb-4 mx-auto">
            <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
            </svg>
          </div>
          <h3 class="text-xl font-bold mb-2">Principais Sub Temas</h3>
          <p class="text-gray-700 p-3 rounded-lg" style="background-color: #F3EEFE;">
            Todos os assuntos mais cobrados em concursos: ECA, BNCC, LDB, PNE, PPP, Planejamento Escolar, História da Educação e muito mais. Conteúdo completo e atualizado.
          </p>
        </div>

        <!-- Benefit 4 -->
        <div class="bg-white p-6 rounded-xl shadow-lg hover:shadow-xl transition-shadow text-center">
          <div class="w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center mb-4 mx-auto">
            <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold mb-2">Área de Estudo</h3>
          <p class="text-gray-700 p-3 rounded-lg" style="background-color: #F3EEFE;">
            Mapas mentais exclusivos que facilitam a memorização, PDFs organizados por tema e guias práticos de estudo. Material de apoio completo para turbinar seu aprendizado.
          </p>
        </div>

        <!-- Benefit 5 -->
        <div class="bg-white p-6 rounded-xl shadow-lg hover:shadow-xl transition-shadow text-center">
          <div class="w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center mb-4 mx-auto">
            <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold mb-2">Estatísticas Avançadas</h3>
          <p class="text-gray-700 p-3 rounded-lg" style="background-color: #F3EEFE;">
            Acompanhe seu desempenho em tempo real com gráficos detalhados. Identifique seus pontos fortes e fracos em cada tema e foque no que realmente precisa melhorar.
          </p>
        </div>

        <!-- Benefit 6 -->
        <div class="bg-white p-6 rounded-xl shadow-lg hover:shadow-xl transition-shadow text-center">
          <div class="w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center mb-4 mx-auto">
            <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold mb-2">Certificado</h3>
          <p class="text-gray-700 p-3 rounded-lg" style="background-color: #F3EEFE;">
            Receba seu certificado digital de conclusão ao finalizar os estudos. Comprove sua dedicação e adicione mais um diferencial ao seu currículo profissional.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Antes e Depois do Simulado -->
  <section class="section-padding bg-white">
    <div class="container-custom">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-neutral-dark mb-4">
          Antes e Depois do Simulado PedagoMais
        </h2>
        <p class="text-lg md:text-xl text-neutral-dark/85 max-w-3xl mx-auto">
          Veja a transformação na sua preparação para concursos
        </p>
      </div>

      <div class="max-w-4xl mx-auto">
        <div class="bg-white rounded-2xl shadow-2xl overflow-hidden">
          <video 
            data-lazy-video
            loop 
            muted 
            playsinline
            width="1280"
            height="720"
            class="w-full h-auto"
            poster="/favicon.webp"
          >
            <source data-src="/Antes e depois do simulado PedagoMais.mp4" type="video/mp4" />
            Seu navegador não suporta vídeos HTML5.
          </video>
        </div>
      </div>

      <script>
        // Lazy load video with Intersection Observer
        if ('IntersectionObserver' in window) {
          const videoObserver = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
              if (entry.isIntersecting) {
                const video = entry.target as HTMLVideoElement;
                const source = video.querySelector('source[data-src]') as HTMLSourceElement;
                
                if (source && source.dataset.src) {
                  source.src = source.dataset.src;
                  video.load();
                  video.play().catch(() => {
                    // Autoplay pode falhar em alguns navegadores
                  });
                  videoObserver.unobserve(video);
                }
              }
            });
          }, {
            rootMargin: '50px'
          });

          const lazyVideo = document.querySelector('[data-lazy-video]');
          if (lazyVideo) {
            videoObserver.observe(lazyVideo);
          }
        } else {
          // Fallback para navegadores sem Intersection Observer
          const video = document.querySelector('[data-lazy-video]') as HTMLVideoElement;
          const source = video?.querySelector('source[data-src]') as HTMLSourceElement;
          if (source && source.dataset.src) {
            source.src = source.dataset.src;
            video.load();
          }
        }
      </script>
    </div>
  </section>

  <!-- O que você vai receber -->
  <WhatYouGetSection />

  <!-- Depoimentos -->
  <TestimonialsSection />

  <!-- CTA Intermediário -->
  <section class="py-12 md:py-16 bg-gradient-to-r from-primary to-secondary">
    <div class="container-custom text-center">
      <h2 class="text-2xl md:text-3xl lg:text-4xl font-bold text-white mb-4">
        Pronto para Conquistar Sua Aprovação?
      </h2>
      <p class="text-lg md:text-xl text-white/90 mb-8 max-w-2xl mx-auto">
        Junte-se a milhares de professores que já estão se preparando com a melhor plataforma de estudos!
      </p>
      <a
        href="/#pagamento"
        class="inline-flex items-center gap-2 bg-white text-primary font-bold text-lg px-8 py-4 rounded-xl hover:bg-gray-100 transition-all shadow-lg hover:shadow-xl hover:scale-105"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
        </svg>
        Começar Agora
      </a>
    </div>
  </section>

  <!-- Mapas Mentais -->
  <StudyAreaSection />

  <!-- Certificado -->
  <CertificateSection />

  <!-- Seção de Pagamento com Timer -->
  <PricingSection client:visible />

  <!-- FAQ -->
  <FAQSection client:visible />

  <!-- CTA Final -->
  <section class="py-16 md:py-20 bg-gradient-to-r from-blue-500 via-blue-400 to-green-400">
    <div class="container-custom">
      <div class="text-center text-white">
        <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold mb-4">
          Não perca essa oportunidade!
        </h2>
        <p class="text-lg md:text-xl mb-8 max-w-2xl mx-auto">
          Comece hoje mesmo sua preparação para a aprovação em Pedagogia
        </p>
        <a
          href="#pagamento"
          class="inline-flex items-center justify-center gap-2 bg-white text-blue-600 hover:bg-gray-100 font-bold text-lg md:text-xl px-8 py-4 rounded-lg shadow-xl hover:shadow-2xl transition-all duration-200"
        >
          Quero Garantir Minha Vaga Agora
        </a>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="bg-neutral-dark text-white py-12">
    <div class="container-custom">
      <div class="grid md:grid-cols-3 gap-8 mb-8">
        <div>
          <h3 class="font-bold text-lg mb-4">PedagoMais</h3>
          <p class="text-gray-400">
            A plataforma mais completa para sua aprovação em concursos de Pedagogia.
          </p>
        </div>
        <div>
          <h3 class="font-bold text-lg mb-4">Links Rápidos</h3>
          <ul class="space-y-2">
            <li><a href="/demonstracao" class="text-gray-400 hover:text-white transition-colors">Demonstração</a></li>
            <li><a href="/termos-de-uso" class="text-gray-400 hover:text-white transition-colors">Termos de Uso</a></li>
            <li><a href="/politica-de-privacidade" class="text-gray-400 hover:text-white transition-colors">Política de Privacidade</a></li>
          </ul>
        </div>
        <div>
          <h3 class="font-bold text-lg mb-4">Contato</h3>
          <p class="text-gray-400">
            <svg class="w-5 h-5 inline mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            contato@pedagomais.net.br
          </p>
        </div>
        <div>
          <h3 class="font-bold text-lg mb-4">Redes Sociais</h3>
          <p class="text-gray-400">
            <svg class="w-5 h-5 inline mr-2" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zM5.838 12a6.162 6.162 0 1112.324 0 6.162 6.162 0 01-12.324 0zM12 16a4 4 0 110-8 4 4 0 010 8zm4.965-10.405a1.44 1.44 0 112.881.001 1.44 1.44 0 01-2.881-.001z"/>
            </svg>
            @pedagomaisoficial
          </p>
        </div>
      </div>
      <div class="border-t border-gray-700 pt-8 text-center text-gray-400">
        <p>&copy; {new Date().getFullYear()} PedagoMais. Todos os direitos reservados.</p>
        <p class="text-sm mt-2">CNPJ: 39.820.902/0001-00</p>
        <p class="text-xs mt-4 max-w-2xl mx-auto leading-relaxed">
          Esta página é de responsabilidade do produtor do conteúdo apresentado. A Meta (Facebook e Instagram) não endossa, apoia ou se responsabiliza por qualquer produto, serviço ou afirmação feita neste site.
        </p>
      </div>
    </div>
  </footer>
</Layout>
