---
import Layout from '../layouts/Layout.astro';

const whatsappNumber = '5588999374009';
const whatsappMessage = encodeURIComponent('Olá! Vim através do Instagram.');
const whatsappUrl = `https://wa.me/${whatsappNumber}?text=${whatsappMessage}`;
---

<Layout 
  title="Contato - PedagoMais" 
  description="Entre em contato com a PedagoMais"
>
  <main class="min-h-screen flex items-center justify-center bg-gradient-to-br from-primary via-secondary to-accent-cyan px-4 py-8">
    <div class="w-full max-w-md">
      {/* Logo/Brand */}
      <div class="text-center mb-12">
        <div class="flex justify-center mb-4">
          <div class="relative bg-white/95 backdrop-blur-sm p-2 rounded-2xl shadow-md">
            <img
              src="/logo-padagomais.png"
              alt="PedagoMais"
              width="80"
              height="80"
              loading="eager"
              class="w-16 h-16 md:w-20 md:h-20"
            />
          </div>
        </div>
        <h1 class="text-3xl font-bold text-white mb-2 drop-shadow-lg">
          PedagoMais
        </h1>
        <p class="text-white/90 text-sm drop-shadow">
          Sua aprovação começa aqui
        </p>
      </div>

      {/* Buttons Container */}
      <div class="space-y-4">
        {/* Main Page Button */}
        <a
          href="https://pedagomais.net.br/?utm_source=instagram_bio&utm_medium=organic"
          class="block w-full bg-white hover:bg-neutral-beige text-primary font-semibold py-4 px-6 rounded-2xl shadow-lg hover:shadow-xl transition-all duration-300 transform hover:scale-105 active:scale-95"
          data-no-utmify
        >
          <div class="flex items-center justify-center gap-3">
            <svg 
              class="w-6 h-6" 
              fill="none" 
              stroke="currentColor" 
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
            </svg>
            <span class="text-lg">Ir para o Site</span>
          </div>
        </a>

        {/* Demonstração Button */}
        <a
          href="/demonstracao"
          class="block w-full bg-neutral-beige hover:bg-neutral-beige/90 text-neutral-dark font-semibold py-4 px-6 rounded-2xl shadow-lg hover:shadow-xl transition-all duration-300 transform hover:scale-105 active:scale-95"
        >
          <div class="flex items-center justify-center gap-3">
            <svg 
              class="w-6 h-6" 
              fill="none" 
              stroke="currentColor" 
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span class="text-lg">Demonstração</span>
          </div>
        </a>

        {/* WhatsApp Button */}
        <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="block w-full bg-secondary hover:bg-secondary/90 text-white font-semibold py-4 px-6 rounded-2xl shadow-lg hover:shadow-xl transition-all duration-300 transform hover:scale-105 active:scale-95"
        >
          <div class="flex items-center justify-center gap-3">
            <svg 
              class="w-6 h-6" 
              fill="currentColor" 
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
            </svg>
            <span class="text-lg">Falar no WhatsApp</span>
          </div>
        </a>
      </div>

      {/* Footer Info */}
      <div class="text-center mt-12 text-white/80 text-sm drop-shadow">
        <p>&copy; {new Date().getFullYear()} PedagoMais</p>
      </div>
    </div>
  </main>
</Layout>
