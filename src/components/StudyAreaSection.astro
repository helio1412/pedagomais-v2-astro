---
// Seção de Mapas Mentais estática
---

<!-- Seção oculta temporariamente para edição futura -->
<section class="section-padding bg-white hidden">
  <div class="container-custom">
    <div class="text-center mb-8 md:mb-12 lg:mb-16">
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-neutral-dark mb-4">
        Área de Estudos
      </h2>
      <p class="text-lg md:text-xl text-neutral-dark/85 max-w-3xl mx-auto">
        Tenha acesso a mapas mentais completos que organizam todo o conteúdo de Pedagogia de forma visual e prática. Facilite sua memorização e compreensão dos principais temas cobrados em concursos.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
      {[1, 2, 3, 4, 5, 6].map((num) => (
        <div class="bg-neutral-beige rounded-2xl overflow-hidden shadow-lg hover:shadow-xl transition-all duration-300 hover:scale-105">
          <div class="relative aspect-[4/3] bg-white">
            <img
              src={`/imagem mapa mental ${num}.webp`}
              alt={`Mapa Mental ${num}`}
              class="w-full h-full object-cover"
              loading="lazy"
            />
          </div>
          <div class="p-4 text-center">
            <p class="font-semibold text-neutral-dark">
              Amostra {num}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
