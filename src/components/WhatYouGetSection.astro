---
// Seção estática "O que você vai receber"
const includes = [
  'Acesso vitalício à plataforma no celular ou computador',
  'Mais de 800 questões de Pedagogia',
  '8 temas completos com simulados ilimitados',
  'Estatísticas detalhadas de desempenho',
  'Materiais complementares (PDFs, mapas mentais)',
  'Atualizações constantes de conteúdo',
  'Suporte via WhatsApp',
  'Garantia de 7 dias',
];
---

<section class="section-padding bg-white">
  <div class="container-custom">
    <div class="text-center mb-8 md:mb-12 lg:mb-16">
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-neutral-dark mb-4">
        O que você vai receber
      </h2>
      <p class="text-lg md:text-xl text-neutral-dark/85">
        Acesso completo a todos os recursos da plataforma
      </p>
    </div>

    <div class="max-w-3xl mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {includes.map((item) => (
          <div class="flex items-start gap-3 p-4 rounded-xl shadow-sm" style="background-color: #F3EEFE;">
            <svg class="w-6 h-6 text-secondary flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            <span class="text-neutral-dark font-medium">{item}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
