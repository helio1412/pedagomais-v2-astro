---
import VideoPlayer from './islands/VideoPlayer';
---

<section class="relative bg-gradient-to-br from-primary via-secondary to-accent-cyan section-padding overflow-hidden">
  <!-- Padrão geométrico estático -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none">
    <div class="absolute inset-0 opacity-5">
      <div class="absolute top-0 left-0 w-full h-full" style="background-image: url(&quot;data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='1'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E&quot;);"></div>
    </div>
  </div>

  <!-- Logo no canto superior esquerdo -->
  <div class="absolute top-2 left-2 md:top-6 md:left-6 z-20">
    <img
      src="/Logo pedagoMais.webp"
      alt="PedagoMais"
      width="200"
      height="80"
      class="w-32 md:w-48 h-auto"
      loading="eager"
    />
  </div>

  <div class="container-custom relative z-10">
    <div class="text-center mb-8 md:mb-12 pt-8 md:pt-0">

      <!-- Título -->
      <h1 class="text-2xl md:text-4xl lg:text-6xl font-bold mb-3 md:mb-6 leading-tight">
        <span class="bg-gradient-to-r from-white via-neutral-beige to-white bg-clip-text text-transparent drop-shadow-lg">
          Chega de gabaritos e PDFs!
        </span>
      </h1>

      <p class="text-base md:text-lg lg:text-xl text-white/95 mb-4 md:mb-8 max-w-3xl mx-auto leading-relaxed font-medium drop-shadow-md">
        Simulados inteligentes que explicam suas respostas em tempo real. Estude Pedagogia a qualquer hora e em qualquer lugar
      </p>
    </div>

    <!-- Vídeo -->
    <div class="max-w-4xl mx-auto mb-6 md:mb-8">
      <p class="text-center text-lg md:text-xl font-semibold text-white mb-3 md:mb-4 drop-shadow-md">
        Veja o vídeo abaixo
      </p>
      
      <VideoPlayer 
        client:visible
        videoId="6967ecea3565f9f404c7efbf"
        accountId="d8c67f45-3b94-4e79-acef-492de65509d1"
      />

      <!-- Aviso sobre som -->
      <div class="flex items-center justify-center gap-2 mt-4 text-white/90">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z" />
        </svg>
        <p class="text-sm md:text-base font-medium">
          Verifique se o som está ligado
        </p>
      </div>
    </div>

    <!-- CTAs -->
    <div class="text-center">
      <div class="flex flex-col gap-4 justify-center items-center">
        <a 
          href="#cta-final"
          class="btn btn-secondary transition-opacity duration-500"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          Quero Minha Aprovação
        </a>
        <a 
          href="/demonstracao"
          class="inline-flex items-center gap-2 bg-purple-500 hover:bg-purple-600 text-white font-bold text-base md:text-lg px-8 py-4 rounded-xl transition-all duration-300 shadow-lg hover:shadow-xl"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
          </svg>
          Teste Rápido
        </a>
      </div>
    </div>
  </div>
</section>

